name: Make release keystore

# Не используется: keystore генерируется ЛОКАЛЬНО и заливается в Secrets.
# Файл оставлен как заготовка — НИКОГДА не запускайте генерацию ключа подписи
# на публичном репозитории: артефакты публичных репо доступны всем.

on:
  workflow_dispatch:

jobs:
  create:
    runs-on: ubuntu-latest
    steps:
      - name: This workflow is intentionally disabled
        run: |
          echo "Generate the keystore locally and upload it via repo secrets."
          exit 1

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Шапка: логотип + название 28sp/700/-0.02em -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:contentDescription="@string/app_name"
            android:src="@mipmap/ic_launcher" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:letterSpacing="-0.02"
            android:text="@string/app_name"
            android:textColor="@color/text"
            android:textSize="26sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Надзаголовок-капс (12sp/600/+0.08em) -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:letterSpacing="0.08"
        android:text="@string/overline_direction"
        android:textColor="@color/text2"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textAllCaps="true" />

    <!-- Направление: сегмент-таблетки -->
    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/directionGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:selectionRequired="true"
        app:singleSelection="true">

        <Button
            android:id="@+id/btnAuto"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/dir_auto" />

        <Button
            android:id="@+id/btnEnRu"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/dir_en_ru" />

        <Button
            android:id="@+id/btnRuEn"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/dir_ru_en" />
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <!-- Поле ввода: r11, без рамки, поверхность field -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:cardBackgroundColor="@color/field"
        app:cardCornerRadius="11dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">

        <EditText
            android:id="@+id/source"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:gravity="top"
            android:hint="@string/source_hint"
            android:importantForAutofill="no"
            android:inputType="textMultiLine|textCapSentences"
            android:minLines="5"
            android:padding="14dp"
            android:textColor="@color/text"
            android:textColorHint="@color/text2"
            android:textSize="16sp" />
    </com.google.android.material.card.MaterialCardView>

    <!-- Кнопки-таблетки: главная одна, остальное field -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/translateBtn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:layout_weight="1.4"
            android:backgroundTint="@color/accent"
            android:text="@string/translate"
            android:textColor="@color/on_accent"
            app:shapeAppearanceOverlay="@style/ShapePill" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/swapBtn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:layout_weight="0.55"
            android:backgroundTint="@color/field"
            android:text="@string/swap"
            android:textColor="@color/text"
            app:iconGravity="textStart"
            app:shapeAppearanceOverlay="@style/ShapePill" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/copyBtn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.05"
            android:backgroundTint="@color/field"
            android:text="@string/copy"
            android:textColor="@color/text"
            app:shapeAppearanceOverlay="@style/ShapePill" />
    </LinearLayout>

    <!-- Статус: слово + цвет вердикта -->
    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/hint_models"
        android:textColor="@color/text2"
        android:textSize="13sp" />

    <!-- Надзаголовок результата -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:letterSpacing="0.08"
        android:text="@string/overline_result"
        android:textColor="@color/text2"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textAllCaps="true" />

    <!-- Карточка перевода: r14 -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:cardBackgroundColor="@color/card"
        app:cardCornerRadius="14dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">

        <TextView
            android:id="@+id/output"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minLines="4"
            android:padding="14dp"
            android:textColor="@color/text"
            android:textIsSelectable="true"
            android:textSize="17sp" />
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/modelsBtn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="12dp"
        android:backgroundTint="@color/field"
        android:text="@string/download_models"
        android:textColor="@color/text"
        app:shapeAppearanceOverlay="@style/ShapePill" />
</LinearLayout>
